# Copy this to .env, uncomment exactly one of the two key lines below and put
# your own value on it, then restrict the file:
#
#   cp .env.example .env
#   chmod 600 .env
#
# .env is gitignored. Never commit it. Get a key at https://openrouter.ai/keys
# and give it a spend limit while you are there. See SECURITY.md.
#
# Exactly one: the first uncommented OPENROUTER_API_KEY line is the one that is
# used, so a leftover second one silently shadows the key you meant to use and
# every call comes back 401.

# A literal key:
#OPENROUTER_API_KEY=sk-or-v1-replace-me

# Or a reference, if you keep secrets in a manager instead. 1Password is
# supported out of the box and the reference is resolved at startup: either run
# under `op run --env-file .env -- uv run arena.py`, or run normally and it is
# resolved with `op read`.
#OPENROUTER_API_KEY=op://Private/OpenRouter/credential
